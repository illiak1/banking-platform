{
  "compilerOptions": {
    "module": "Node16",
    "target": "es2017",
    "strict": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "moduleResolution": "node16",
    "isolatedModules": true,
    // rootDir must be explicit: without it TypeScript infers the "common source
    // directory" from whichever files are in the program, which differs between
    // a full build and ts-jest compiling a single spec file (error TS5011).
    "rootDir": ".",
    "outDir": "./dist",
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": [
    "src/**/*.ts",
    "prisma/prisma.service.ts",
    "prisma/seed.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts"
  ]
}
