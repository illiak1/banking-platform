# Copy to backend/.env and fill in. The app refuses to boot without these two.

# Matches the credentials in docker-compose.yml at the repo root.
# Note the database is named `minibank`, not `mini_banking`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minibank"

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Port the API listens on. Defaults to 3000.
# Set this if the React dev server has already taken 3000.
# PORT=3000

# Optional. Comma-separated list of origins allowed to call the API.
# Defaults to http://localhost:3000,http://localhost:3001
# CORS_ORIGIN=http://localhost:3001
