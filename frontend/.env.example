# Copy to frontend/.env if the API is not on http://localhost:3000.
# Create React App only exposes variables prefixed with REACT_APP_.

REACT_APP_API_URL=http://localhost:3000

# The backend listens on 3000 by default, which is also CRA's default port.
# Start the backend first and let CRA move to 3001, or set PORT here.
# PORT=3001
